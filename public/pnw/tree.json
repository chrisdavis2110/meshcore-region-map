use.","source":"pnw","counties":["Umatilla"],"also":[],"highlight":null,"chain":["west","pnw","or","c-or","pdt"]},"bke":{"id":"bke","code":"bke","name":"Baker City","kind":"local","parent":"c-or","color":"#a67c52","note":"Baker County.","source":"pnw","counties":["Baker"],"also":[],"highlight":null,"chain":["west","pnw","or","c-or","bke"]},"bc":{"id":"bc","code":"bc","name":"British Columbia (southern)","kind":"state","parent":"pnw","color":"#1a365d","note":"Southern coast only: the Lower Mainland and Vancouver Island. The interior and the north are outside this hierarchy.","source":"intermountain","counties":["Metro Vancouver Regional District","Fraser Valley Regional District","Capital Regional District","Cowichan Valley Regional District","Regional District of Nanaimo","Regional District of Alberni-Clayoquot","Comox Valley Regional District"],"also":[],"highlight":null,"chain":["west","pnw","bc"]},"swbc":{"id":"swbc","code":"swbc","name":"Southwest BC / Lower Mainland","kind":"region","parent":"bc","color":"#2a6f8f","note":"Metro Vancouver and the Fraser Valley regional districts.","source":"pnw","counties":["Metro Vancouver Regional District","Fraser Valley Regional District"],"also":[],"highlight":null,"chain":["west","pnw","bc","swbc"]},"vanisle":{"id":"vanisle","code":"vanisle","name":"Vancouver Island","kind":"region","parent":"bc","color":"#2f7d4f","note":"The island regional districts from the Capital through Comox and the west coast. Mount Waddington and Strathcona also sit with the island, but their official boundaries take in large mainland inlets, so they stay outside this outline.","source":"pnw","counties":["Capital Regional District","Cowichan Valley Regional District","Regional District of Nanaimo","Regional District of Alberni-Clayoquot","Comox Valley Regional District"],"also":[],"highlight":null,"chain":["west","pnw","bc","vanisle"]},"southisland":{"id":"southisland","code":"southisland","name":"South Vancouver Island / Victoria","kind":"local",